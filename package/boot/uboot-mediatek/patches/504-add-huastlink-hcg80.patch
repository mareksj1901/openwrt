++
++	wdt_gpio: watchdog {
++		compatible = "linux,wdt-gpio";
++		gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
++		hw_algo = "toggle";
++		hw_margin_ms = <1000>;
++	};
