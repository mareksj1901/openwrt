++// SPDX-License-Identifier: GPL-2.0-or-later
++/*
++ * Copyright (C) 2026 Maxis
++ *
++ * U-Boot board support (defconfig, board DTS, default environment and
++ * boot scripts) created/reworked by Maxis.
++ */
++
++/dts-v1/;
++#include "mt7981.dtsi"
++#include <dt-bindings/gpio/gpio.h>
